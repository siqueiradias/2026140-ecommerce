# .env.example
# Template for the environment variables used by the server.
# 1. Make a copy of this file and name it ".env" (in the same folder).
# 2. Replace the values with your own MySQL details.
# The real .env file is listed in .gitignore, so it is never uploaded to GitHub.

# Web server
PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=natura_essence
